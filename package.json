{
  "name": "devanture",
  "version": "0.1.0",
  "description": "Devanture : langage déclaratif (YAML) pour sites vitrines et petites boutiques, compilé en PHP + JS + CSS par sitec. Écrit pour les modèles de langage autant que pour les humains.",
  "type": "module",
  "bin": {
    "sitec": "./bin/sitec.js"
  },
  "scripts": {
    "check": "node bin/sitec.js check examples/plomberie-martin",
    "build": "node bin/sitec.js build examples/plomberie-martin",
    "build:studio": "node scripts/build-studio.mjs",
    "verify:shop": "node scripts/verify-shop.mjs examples/savonnerie/dist 8970",
    "verify:site": "node scripts/verify-php-site.mjs examples/plomberie-martin/dist 8971"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gpt-tokenizer": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "components",
    "studio/index.html",
    "studio/app.js",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VOTRE-COMPTE/devanture.git"
  },
  "keywords": [
    "dsl",
    "yaml",
    "php",
    "site-generator",
    "llm"
  ]
}
